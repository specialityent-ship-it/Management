# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://opd:opd@localhost:5432/opd_management?schema=public"
APP_URL="http://localhost:3000"

# Signs the staff session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Protects /api/cron/* (scheduled social publishing, follow-up reminders).
CRON_SECRET="change-me-too"

# ---------------------------------------------------------------------------
# Clinic identity — shown across the public website
# ---------------------------------------------------------------------------
CLINIC_NAME="Speciality ENT"
CLINIC_TAGLINE="OPD & Operation Theatre care, end to end"
CLINIC_PHONE="+91 00000 00000"
CLINIC_EMAIL="hello@example.com"
CLINIC_ADDRESS="123 Example Road, City 000000"
CLINIC_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------------
# Email notifications — any SMTP provider (Google Workspace, SES, Zoho…).
# Leave empty to disable email; bookings still work, nothing is emailed.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Speciality ENT <hello@example.com>"

# ---------------------------------------------------------------------------
# WhatsApp notifications — Meta WhatsApp Cloud API.
#
# Business-initiated messages MUST use a template approved in WhatsApp
# Manager. Create one template per message below, then either name them
# exactly as listed or map your approved names with the overrides.
# Each template's body needs numbered placeholders ({{1}}, {{2}}, …) in the
# same order as the parameters listed in src/lib/notifications/templates.ts.
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_DEFAULT_COUNTRY_CODE="91"

# Optional: map to your approved template names if they differ.
WHATSAPP_TEMPLATE_BOOKING_RECEIVED=""
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=""
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=""
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=""
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=""
WHATSAPP_TEMPLATE_OT_SCHEDULED=""

# How far ahead the reminder job looks.
REMINDER_HOURS_AHEAD="24"

# ---------------------------------------------------------------------------
# Payments — Razorpay (https://dashboard.razorpay.com/app/keys)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same value in Razorpay Dashboard > Webhooks, subscribing to
# payment.captured, payment.failed and refund.processed.
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# AI chatbot — Anthropic (https://console.anthropic.com/settings/keys)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Instagram — Graph API. Requires a Facebook Page linked to an Instagram
# *Business* or *Creator* account, plus a long-lived page access token with
# instagram_basic, instagram_content_publish and pages_read_engagement.
# ---------------------------------------------------------------------------
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ---------------------------------------------------------------------------
# YouTube — OAuth 2.0 Web client with the YouTube Data API v3 enabled.
# Obtain the refresh token once via /admin/social/connect.
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/youtube/callback"
YOUTUBE_REFRESH_TOKEN=""
